{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=notiheart;Username=noti;Password=noti"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "DispatchExchange": "notifications.dispatch",
    "RetryExchange": "notifications.retry",
    "QueueName": "notifications.email.q",
    "RetryQueueName": "notifications.email.retry.q",
    "DeadLetterQueueName": "notifications.email.dlq",
    "RoutingKey": "email",
    "RetryDelayMs": 30000
  },
  "Worker": {
    "Channel": "Email",
    "MaxAttempts": 5,
    "MockAlwaysFail": false,
    "MockPermanentFailure": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
