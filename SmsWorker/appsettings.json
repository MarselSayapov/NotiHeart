{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=notiheart;Username=noti;Password=noti"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "DispatchExchange": "notifications.dispatch",
    "RetryExchange": "notifications.retry",
    "QueueName": "notifications.sms.q",
    "RetryQueueName": "notifications.sms.retry.q",
    "DeadLetterQueueName": "notifications.sms.dlq",
    "RoutingKey": "sms",
    "RetryDelayMs": 30000
  },
  "Worker": {
    "Channel": "Sms",
    "MaxAttempts": 5
  },
  "SmsSender": {
    "ForceTemporaryFailure": false,
    "ForcePermanentFailure": false,
    "TemporaryFailureRate": 0.0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
